// fontread.nv — the loops, written once, over whatever the host can
// read with.
//
// EVERY FUNCTION HERE IS EFFECT-POLYMORPHIC, and that is the whole
// module.  `S: FontSource[e]` binds the effect parameter of this
// package's own trait (`fontsrc`), and every clause is `[e]`, so the
// row means "whatever the impl behind `S` supplies": `[io, fs]` when
// the source is a `File`, nothing at all when it is a buffer the
// caller already holds.  The package has named no effect of its own
// and stays `core` either way (SPEC § 5.6, and `docs/publishing.md`
// § Design, third shape).
//
// WHY THESE LOOPS ARE IN THE PACKAGE AND NOT IN THE README.  Each one
// is a sequence of dependent reads where the SECOND read's offset
// comes out of the first read's bytes:
//
//   the offset table says how many tables, so the directory's length
//   is not known until the first twelve bytes are in;
//
//   `head.indexToLocFormat` says how wide `loca`'s entries are, so
//   `loca` cannot be parsed before `head` has been read;
//
//   `loca` says where the glyph is, so the glyph cannot be read until
//   `loca` has;
//
//   and a composite glyph names components whose records are found the
//   same way, recursively.
//
// Written out by a caller, that is twenty lines with four places to
// get an offset base wrong, repeated in every consumer.  Written here,
// it is one function each and the consumer writes the four-line impl
// of `FontSource` instead.
//
// A CALLER THAT HOLDS THE WHOLE FILE PAYS NOTHING FOR THIS.  A
// `FontSource` over a `Bytes` is `fontsrc.slice` with an `Ok` around
// it, its effect row is empty, and these functions are then ordinary
// pure calls — the same code, charged nothing.

use fonterror
use fontsrc
use fontdir
use fontmetric
use fontcmap
use fontglyf
use fontgsub
use fontkern
use fontshape
use svgpath

// Read a face's table directory.
//
// Two reads for a plain font — the twelve-byte offset table, then the
// directory whose length it declares — and three for a collection,
// where the first read is the `ttcf` header and `index` selects the
// face.
//
// `FontNoSuchFace` when the index is past the end of a collection,
// carrying both numbers.  A non-zero `index` on a file that is not a
// collection is the same fault with a count of 1, rather than a
// silently ignored argument.
//
// ```novo ignore
// fn open_font(path: Str) -> Result<FontFace, FontFault> [io, fs]
//     match File.open_read(path)
//         None    => Err(FontSourceFailed("not found"))
//         Some(f) => fontread.read_face(FontFile { handle: f }, 0)
// ```
pub fn read_face<S: FontSource[e]>(src: S,
                                   index: Int) -> Result<fontdir.FontFace, fonterror.FontFault> [e]
    let head = src.font_bytes(fontsrc.range(0, 12))!
    if fontdir.is_collection(head)
        let count = fontdir.collection_faces(head)
        let header = src.font_bytes(fontdir.collection_header_range(count))!
        let at = fontdir.collection_face_at(header, index)!
        let face = read_directory(src, at)!
        return Ok(FontFace { sfnt: face.sfnt, index: index, face_count: count, tables: face.tables })
    if index != 0
        return Err(FontNoSuchFace(index, 1))
    read_directory(src, 0)
// Read the offset table at `at` and the directory it declares.  Table
// offsets count from the start of the file, in a font and in the faces of
// a collection alike.
fn read_directory<S: FontSource[e]>(src: S,
                                    at: Int) -> Result<fontdir.FontFace, fonterror.FontFault> [e]
    let head = src.font_bytes(fontsrc.range(at, fontdir.header_len()))!
    if not fontdir.is_sfnt(head)
        return Err(FontNotSfnt(bytes.u32_be_at(head, 0) ?? 0))
    let n = fontdir.table_count_of(head)
    let whole = src.font_bytes(fontsrc.range(at, fontdir.header_len() + fontdir.directory_len(n)))!
    fontdir.parse_directory(whole, 0)

// How many faces the file holds.
//
// One read.  For a font manager listing a `.ttc` before it opens any
// of them.
pub fn read_face_count<S: FontSource[e]>(src: S) -> Result<Int, fonterror.FontFault> [e]
    let head = src.font_bytes(fontsrc.range(0, 12))!
    if fontdir.is_collection(head)
        return Ok(fontdir.collection_faces(head))
    if not fontdir.is_sfnt(head)
        return Err(FontNotSfnt(bytes.u32_be_at(head, 0) ?? 0))
    Ok(1)

// Read one whole table by tag.
//
// `FontNoTable` when the directory has no entry — which is the answer
// for `kern` in most fonts and for `GPOS` in old ones.  A refusal
// rather than an empty `Bytes`, because "the font has no kerning" and
// "the font has an empty kern table" are different facts and a caller
// reporting on a font needs both.
pub fn read_table<S: FontSource[e]>(src: S, face: fontdir.FontFace,
                                    tag: Int) -> Result<Bytes, fonterror.FontFault> [e]
    match fontdir.table_range(face, tag)
        Some(r) => src.font_bytes(r)
        None    => Err(FontNoTable(tag))

// Read several tables, in the order the tags are given.
//
// For the caller whose source charges per request — an HTTP range
// reader, a flash controller — where four separate asks are four round
// trips.  A missing table is an EMPTY `Bytes` in its slot rather than
// a refusal, because the common use is "read what is there";
// `fontdir.has_table` is how a caller asks the other question.
pub fn read_tables<S: FontSource[e]>(src: S, face: fontdir.FontFace,
                                     tags: [Int]) -> Result<[Bytes], fonterror.FontFault> [e]
    var out: [Bytes] = []
    for tag in tags
        match fontdir.table_range(face, tag)
            Some(r) => list.push(out, src.font_bytes(r)!)
            None    => list.push(out, bytes.zeros(0))
    Ok(out)

// Read `head`, `hhea` and `maxp` and gather the metrics.
//
// Three reads, and the value every other call needs.  `FontNoTable`
// naming whichever is missing, because a font without `head` is not a
// font and a caller deserves to be told which one it was.
pub fn read_metrics<S: FontSource[e]>(src: S,
                                      face: fontdir.FontFace) -> Result<fontmetric.FontMetrics, fonterror.FontFault> [e]
    let head = fontmetric.parse_head(read_table(src, face, fontdir.tag_head())!)!
    let hhea = fontmetric.parse_hhea(read_table(src, face, fontdir.tag_hhea())!)!
    let maxp = fontmetric.parse_maxp(read_table(src, face, fontdir.tag_maxp())!)!
    Ok(fontmetric.metrics(head, hhea, maxp))

// Read `cmap` and parse the subtable `fontcmap.best_subtable` picks.
//
// One read of the whole `cmap` table, which holds every subtable the font
// carries; the one that is picked is parsed and the rest are dropped.
//
// `FontNoUsableCmap` when nothing in the list is format 4 or 12.
pub fn read_cmap<S: FontSource[e]>(src: S,
                                   face: fontdir.FontFace) -> Result<fontcmap.FontCmap, fonterror.FontFault> [e]
    let range = match fontdir.table_range(face, fontdir.tag_cmap())
        Some(r) => r
        None    =>
            return Err(FontNoTable(fontdir.tag_cmap()))
    let table = src.font_bytes(range)!
    let subs = fontcmap.subtables(table, range)!
    let best = match fontcmap.best_subtable(subs)
        Some(s) => s
        None    =>
            return Err(FontNoUsableCmap)
    let from = best.range.at - range.at
    fontcmap.parse_subtable(bytes.slice(table, from, bytes.len(table)), best)

// Read `loca`, having first read `head` for its format.
//
// The dependent pair this module exists for: `loca`'s entries are two
// bytes or four depending on a field in a different table, and a
// `loca` read with the wrong width parses as noise rather than
// failing.
pub fn read_loca<S: FontSource[e]>(src: S, face: fontdir.FontFace,
                                   m: fontmetric.FontMetrics) -> Result<fontglyf.FontLoca, fonterror.FontFault> [e]
    let data = read_table(src, face, fontdir.tag_loca())!
    fontglyf.parse_loca(data, m.num_glyphs, m.long_loca)

// Read one glyph's outline, following composites to their components.
//
// The loop: `loca` says where the record is, the record says whether
// it is simple or composite, and a composite's components are read the
// same way to `fontglyf.component_limit` and no further.
//
// The path is in FONT UNITS.  `fontmetric.scale_for_px` is the
// transform to pixels, and the two are separate calls because a
// rasteriser caches an outline per glyph and applies a transform per
// size — see the README's § Font units are not pixels.
//
// Reads exactly the glyph records it needs: one for a simple glyph,
// one plus its components for a composite.  Nothing else in `glyf` is
// touched, which is why a terminal can draw ASCII out of a CJK font
// without reading twenty megabytes.
pub fn read_outline<S: FontSource[e]>(src: S, face: fontdir.FontFace, loca: fontglyf.FontLoca,
                                      glyph: Int) -> Result<svgpath.SvgPath, fonterror.FontFault> [e]
    let glyf = match fontdir.table_range(face, fontdir.tag_glyf())
        Some(r) => r
        None    =>
            return Err(FontNoTable(fontdir.tag_glyf()))
    var reads = Reads { left: component_budget() }
    outline_at(src, glyf, loca, glyph, 0, var reads)
// How many glyph records one outline may read.  Components may name
// components many times over, and the depth limit alone still allows a
// tree of reads no glyph is worth.
fn component_budget() -> Int
    4096

// The records still allowed to be read for one outline.
struct Reads
    var left: Int

// One glyph's outline, reading its record and, for a composite, its
// components one level deeper.
fn outline_at<S: FontSource[e]>(src: S, glyf: fontsrc.FontRange, loca: fontglyf.FontLoca,
                                glyph: Int, depth: Int,
                                var reads: Reads) -> Result<svgpath.SvgPath, fonterror.FontFault> [e]
    if depth > fontglyf.component_limit()
        return Err(FontCompositeTooDeep(glyph, depth))
    let range = match fontglyf.glyph_file_range(loca, glyf, glyph)
        Some(r) => r
        None    =>
            return Err(FontNoSuchGlyph(glyph, fontglyf.loca_glyph_count(loca)))
    if fontsrc.is_empty(range)
        return Ok(svgpath.empty())
    reads.left -= 1
    if reads.left < 0
        return Err(FontBadField(fontdir.tag_glyf(), "components", component_budget()))
    let record = src.font_bytes(range)!
    if fontglyf.glyph_kind(record) != FontGlyphComposite
        return fontglyf.outline(record)
    let comps = fontglyf.components(record)!
    if fontglyf.names_itself(glyph, comps)
        return Err(FontCompositeTooDeep(glyph, depth + 1))
    var parts: [svgpath.SvgPath] = []
    for c in comps
        list.push(parts, outline_at(src, glyf, loca, c.glyph, depth + 1, var reads)!)
    fontglyf.compose(record, parts)

// Read several glyphs' outlines in one pass.
//
// The call an atlas builder makes: a terminal wants the 95 printable
// ASCII glyphs and wants them without 95 round trips.  Reads are
// sorted by file offset inside, so a source that charges for a seek
// pays for one forward pass rather than a random walk.
pub fn read_outlines<S: FontSource[e]>(src: S, face: fontdir.FontFace, loca: fontglyf.FontLoca,
                                       glyphs: [Int]) -> Result<[svgpath.SvgPath], fonterror.FontFault> [e]
    let glyf = match fontdir.table_range(face, fontdir.tag_glyf())
        Some(r) => r
        None    =>
            return Err(FontNoTable(fontdir.tag_glyf()))
    var order: [Int] = []
    for i in 0..list.len(glyphs)
        var at = 1 << 40
        match fontglyf.glyph_range(loca, glyphs[i])
            Some(r) =>
                at = r.at
            None    => ()
        list.push(order, (at << 20) | i)
    list.sort(order)
    var out: [svgpath.SvgPath] = []
    for _ in glyphs
        list.push(out, svgpath.empty())
    var reads = Reads { left: component_budget() }
    for key in order
        let i = key & 0xFFFFF
        out[i] = outline_at(src, glyf, loca, glyphs[i], 0, var reads)!
    Ok(out)

// Read the four tables a Latin run needs and build the shaping plan.
//
// `cmap`, `hmtx`, and whichever of `GPOS` and `kern` the font has,
// with the double-kerning rule already applied by
// `fontkern.kern_source`.  `features` is the `GSUB` feature list to
// apply — `fontgsub.default_features` for prose, an empty list for a
// terminal — and `GSUB` is only read when the list is non-empty.
//
// THE ONE CALL A CONSUMER USUALLY WANTS, and the reason the four
// halves are a single value: a plan built from one font's `cmap` and
// another's `hmtx` produces text that is wrong in a way nothing
// reports.
pub fn read_plan<S: FontSource[e]>(src: S, face: fontdir.FontFace, script: Int,
                                   features: [Int]) -> Result<fontshape.FontPlan, fonterror.FontFault> [e]
    let metrics = read_metrics(src, face)!
    let cmap = read_cmap(src, face)!
    let hmtx = read_table(src, face, fontdir.tag_hmtx())!
    var subst = fontgsub.no_substitutions()
    if list.len(features) > 0
        subst = read_subst(src, face, script, 0, features)!
    let kern = read_kerning(src, face, script, 0)!
    Ok(fontshape.plan(cmap, subst, kern, hmtx, metrics))

// Read the `GSUB` plan alone.
//
// For a caller that already has the rest and is changing only which
// features are on — a text editor toggling small capitals.
pub fn read_subst<S: FontSource[e]>(src: S, face: fontdir.FontFace, script: Int, language: Int,
                                    features: [Int]) -> Result<fontgsub.FontSubstPlan, fonterror.FontFault> [e]
    if not fontdir.has_table(face, fontdir.tag_gsub())
        return Ok(fontgsub.no_substitutions())
    let gsub = read_table(src, face, fontdir.tag_gsub())!
    fontgsub.plan(gsub, script, language, features)

// Read the kerning plan alone, choosing its one source.
//
// Reads `GPOS` first, and reads `kern` ONLY when `GPOS` has no `kern`
// feature for the script — so the double-kerning rule saves a read as
// well as a mistake.
pub fn read_kerning<S: FontSource[e]>(src: S, face: fontdir.FontFace, script: Int,
                                      language: Int) -> Result<fontkern.FontKernPlan, fonterror.FontFault> [e]
    var gpos = bytes.zeros(0)
    if fontdir.has_table(face, fontdir.tag_gpos())
        gpos = read_table(src, face, fontdir.tag_gpos())!
    var kern = bytes.zeros(0)
    if fontdir.has_table(face, fontdir.tag_kern()) and not fontkern.gpos_has_kern(gpos, script, language)
        kern = read_table(src, face, fontdir.tag_kern())!
    fontkern.plan(gpos, kern, script, language)

// ── For a caller that holds the whole file ───────────────────────────

// A `FontSource` over a buffer the caller already has.
//
// The other end of the trait, and the one that costs nothing: its
// `font_bytes` is `fontsrc.slice` with an `Ok` around it and its
// effect row is empty, so every function above becomes a pure call.
//
// Published so that the common case — a font read into memory at
// startup, which is what a terminal and a plot renderer both do — does
// not have to write an impl to use a package built around not needing
// the file.
pub struct FontBuffer
    // The whole font file.
    bytes: Bytes

// Wrap a buffer as a source.
//
// ```novo ignore
// let src = fontread.buffer(file_bytes)
// let face = fontread.read_face(src, 0)!
// ```
pub fn buffer(bytes: Bytes) -> FontBuffer []
    FontBuffer { bytes: bytes }

// Reading a buffer costs nothing, which is what the empty row says.
//
// ```novo
// use fontread
// use bytes
//
// fn main() [io]
//     let src = fontread.buffer(bytes.from_str(""))
//     println("${bytes.len(src.bytes)}")      // 0
// ```
impl FontSource[] for FontBuffer
    fn font_bytes(self, r: fontsrc.FontRange) -> Result<Bytes, fonterror.FontFault> []
        let end = fontsrc.range_end(r)
        if r.at < 0 or r.len < 0 or end > bytes.len(self.bytes)
            return Err(fontsrc.short(0, end, bytes.len(self.bytes)))
        Ok(fontsrc.slice(self.bytes, r))

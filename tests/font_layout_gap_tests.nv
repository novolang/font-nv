// font_layout_gap_tests.nv — the `GSUB` and `GPOS` branches the other
// suites leave unvisited: a ligature record cut inside its components, a
// required feature, a class number past the matrix, and a feature whose
// table cannot be reached.

use std.test
use std.list
use std.bytes
use fontdir
use fontkern
use fontgsub

fn u16(v: Int) -> Bytes
    bytes.u16_be(v)

fn u32(v: Int) -> Bytes
    bytes.u32_be(v)

fn latn() -> Int
    fontdir.tag_of("latn")

fn kern_tag() -> Int
    fontdir.tag_of("kern")

fn script_list_default() -> Bytes
    u16(1) + u32(latn()) + u16(8)
        + u16(4) + u16(0)
        + u16(0) + u16(0xFFFF) + u16(1) + u16(0)

fn feature_list(tag: Int) -> Bytes
    u16(1) + u32(tag) + u16(8)
        + u16(0) + u16(1) + u16(0)

fn lookup_list(kind: Int) -> Bytes
    u16(1) + u16(4)
        + u16(kind) + u16(0) + u16(1) + u16(8)

// The header, the lists, and a lookup of `kind` whose sub-table follows at 56.
fn table_with(tag: Int, kind: Int) -> Bytes
    u16(1) + u16(0) + u16(10) + u16(30) + u16(44)
        + script_list_default() + feature_list(tag) + lookup_list(kind)

// ── GSUB ─────────────────────────────────────────────────────────────

@test
fn test_a_ligature_record_cut_inside_its_components_is_dropped() [io]
    // The sub-table: coverage at 8 (glyph 1), one set at 14, one record
    // at 18 claiming three components with one of the two tail words in
    // the table.
    let gsub = table_with(fontdir.tag_of("liga"), 4)
        + u16(1) + u16(8) + u16(1) + u16(14)
        + u16(1) + u16(1) + u16(1)
        + u16(1) + u16(4)
        + u16(9) + u16(3) + u16(2)
    let p = fontgsub.plan(gsub, latn(), 0, [fontdir.tag_of("liga")])!

    test.case("THE CLAIM: the record that the table cannot finish is not a ligature")
    test.assert(list.len(fontgsub.ligatures(p)) == 0)

@test
fn test_a_glyph_before_every_substitution_is_left_alone() [io]
    let p = FontSubstPlan { ligatures: [],
                            singles: [FontSubst { from_glyph: 10, to_glyph: 110 },
                                      FontSubst { from_glyph: 11, to_glyph: 111 }],
                            features: [] }

    test.case("THE CLAIM: a glyph below the first substitution is found absent")
    let out = fontgsub.apply(p, [5, 11, 20])
    test.assert(list.get(out, 0) == 5)
    test.assert(list.get(out, 1) == 111)
    test.assert(list.get(out, 2) == 20)

// ── GPOS ─────────────────────────────────────────────────────────────

@test
fn test_a_required_feature_counts_as_one_the_script_names() [io]
    // A LangSys with a required feature index of 0 and no listed indices.
    let gpos = u16(1) + u16(0) + u16(10) + u16(28) + u16(42)
        + u16(1) + u32(latn()) + u16(8)
        + u16(4) + u16(0)
        + u16(0) + u16(0) + u16(0)
        + feature_list(kern_tag())
        + lookup_list(2)

    test.case("THE CLAIM: the required feature is `kern`, so the script kerns")
    test.assert(fontkern.gpos_has_kern(gpos, latn(), 0))

@test
fn test_a_feature_whose_table_is_not_there_names_no_lookup() [io]
    // The feature record's offset is 0, which names no Feature table.
    let gpos = u16(1) + u16(0) + u16(10) + u16(30) + u16(0)
        + script_list_default()
        + u16(1) + u32(kern_tag()) + u16(0)
    let p = fontkern.plan(gpos, bytes.zeros(0), latn(), 0)!

    test.case("THE CLAIM: the source is GPOS and the plan adjusts nothing")
    test.assert(p.source == FontKernGpos)
    test.assert(fontkern.kerns_nothing(p))

// A class-based sub-table at 56 with a 2 by 2 matrix [0, -20, -60, 0],
// the coverage {1, 3}, the left definition `left` and the right
// definition `right`.  The header is 16 bytes, the matrix 8, the
// coverage 8 and the left definition `left_len` bytes.
fn class_table(left: Bytes, right: Bytes) -> Bytes
    table_with(kern_tag(), 2)
        + u16(2) + u16(24) + u16(0x0004) + u16(0) + u16(32) + u16(32 + bytes.len(left))
        + u16(2) + u16(2)
        + u16(0) + u16(0 - 20) + u16(0 - 60) + u16(0)
        + u16(1) + u16(2) + u16(1) + u16(3)
        + left + right

@test
fn test_a_class_the_matrix_does_not_hold_adjusts_nothing() [io]
    // Left: glyph 3 is class 5 (a format 2 range).  Right: glyph 1 is
    // class 1 (a format 1 array).
    let gpos = class_table(u16(2) + u16(1) + u16(3) + u16(3) + u16(5),
                           u16(1) + u16(1) + u16(1) + u16(1))
    let p = fontkern.plan(gpos, bytes.zeros(0), latn(), 0)!

    test.case("THE CLAIM: a covered glyph with class 0 reads the matrix")
    test.assert(fontkern.pair_value(p, 1, 1) == 0 - 20)

    test.case("a glyph inside the class array but outside the coverage has no class")
    test.assert(fontkern.pair_value(p, 2, 1) == 0)

    test.case("and a class past the matrix's rows reads nothing")
    test.assert(fontkern.pair_value(p, 3, 1) == 0)

@test
fn test_a_class_definition_that_names_the_last_glyph_ids_is_cut_at_the_glyph_limit() [io]
    // Right: a format 1 array starting at glyph 65535 and claiming 65535
    // classes, none of which the table holds.
    let gpos = class_table(u16(2) + u16(0),
                           u16(1) + u16(65535) + u16(65535))
    let p = fontkern.plan(gpos, bytes.zeros(0), latn(), 0)!

    test.case("THE CLAIM: the plan is built, and a glyph the definition does not name is class 0")
    test.assert(p.source == FontKernGpos)
    test.assert(fontkern.pair_value(p, 1, 1) == 0)

@test
fn test_a_pair_sub_table_cut_before_its_pair_sets_adjusts_nothing() [io]
    test.case("THE CLAIM: a format 1 header with no room for its pair set count is skipped")
    let cut = table_with(kern_tag(), 2) + u16(1) + u16(6) + u16(0x0004) + u16(0)
    let p = fontkern.plan(cut, bytes.zeros(0), latn(), 0)!
    test.assert(fontkern.kerns_nothing(p))

    test.case("and a pair set whose offset is 0 is skipped, not read from the sub-table's start")
    let zero = table_with(kern_tag(), 2)
        + u16(1) + u16(12) + u16(0x0004) + u16(0) + u16(1) + u16(0)
        + u16(1) + u16(1) + u16(1)
    let q = fontkern.plan(zero, bytes.zeros(0), latn(), 0)!
    test.assert(fontkern.kerns_nothing(q))

// ── Extension lookups, the default script, several matrices ──────────

// A script list that names one script, `tag`, with a default LangSys.
fn script_list_for(tag: Int) -> Bytes
    u16(1) + u32(tag) + u16(8)
        + u16(4) + u16(0)
        + u16(0) + u16(0xFFFF) + u16(1) + u16(0)

@test
fn test_an_extension_lookup_is_read_as_the_lookup_it_wraps() [io]
    // Ligature `1 2 -> 9` behind an extension header: format 1, wrapped
    // type 4, and the inner sub-table at 8 from the header.
    let wrapped_ligature = table_with(fontdir.tag_of("liga"), 7)
        + u16(1) + u16(4) + u32(8)
        + u16(1) + u16(8) + u16(1) + u16(14)
        + u16(1) + u16(1) + u16(1)
        + u16(1) + u16(4)
        + u16(9) + u16(2) + u16(2)
    let p = fontgsub.plan(wrapped_ligature, latn(), 0, [fontdir.tag_of("liga")])!

    test.case("THE CLAIM: the ligature behind the extension fires")
    test.assert(list.len(fontgsub.ligatures(p)) == 1)
    test.assert(list.get(fontgsub.apply(p, [1, 2]), 0) == 9)

    test.case("and so does a single substitution behind one")
    let wrapped_single = table_with(fontdir.tag_of("smcp"), 7)
        + u16(1) + u16(1) + u32(8)
        + u16(1) + u16(6) + u16(100)
        + u16(1) + u16(1) + u16(10)
    let q = fontgsub.plan(wrapped_single, latn(), 0, [fontdir.tag_of("smcp")])!
    test.assert(list.get(fontgsub.apply(q, [10]), 0) == 110)

    test.case("an extension that wraps a type the module does not apply names that type")
    let wrapped_alternate = table_with(fontdir.tag_of("liga"), 7) + u16(1) + u16(3) + u32(8)
    match fontgsub.plan(wrapped_alternate, latn(), 0, [fontdir.tag_of("liga")])
        Err(FontLookupType(_, kind)) => test.assert(kind == 3)
        _                            => test.assert(false)

    test.case("and one whose header is not format 1 contributes nothing")
    let odd_format = table_with(fontdir.tag_of("liga"), 7) + u16(2) + u16(4) + u32(8)
    let r = fontgsub.plan(odd_format, latn(), 0, [fontdir.tag_of("liga")])!
    test.assert(list.len(fontgsub.ligatures(r)) == 0)

@test
fn test_a_feature_record_cut_inside_its_tag_names_no_feature() [io]
    // The feature list claims one record and the table ends two bytes into it.
    let cut = u16(1) + u16(0) + u16(10) + u16(30) + u16(44)
        + script_list_default() + u16(1) + u16(0x6C69)

    test.case("THE CLAIM: a tag the table cannot finish is no feature")
    test.assert(list.len(fontgsub.features_present(cut, latn(), 0)) == 0)
    test.assert(not fontkern.gpos_has_kern(cut, latn(), 0))

@test
fn test_a_script_the_font_lacks_falls_back_to_the_default_script() [io]
    let dflt = u16(1) + u16(0) + u16(10) + u16(30) + u16(44)
        + script_list_for(fontdir.tag_of("DFLT")) + feature_list(fontdir.tag_of("liga"))
        + lookup_list(4)

    test.case("THE CLAIM: a Latin run in a font that declares only DFLT finds its features")
    test.assert(fontgsub.has_feature(dflt, latn(), 0, fontdir.tag_of("liga")))
    let gpos = u16(1) + u16(0) + u16(10) + u16(30) + u16(44)
        + script_list_for(fontdir.tag_of("DFLT")) + feature_list(kern_tag()) + lookup_list(2)
    test.assert(fontkern.gpos_has_kern(gpos, latn(), 0))

    test.case("and a font with neither finds none")
    test.assert(not fontgsub.has_feature(table_with(fontdir.tag_of("liga"), 4),
                                         fontdir.tag_of("cyrl"), 0, fontdir.tag_of("liga")))

// A class sub-table with one row and one column, covering glyph 1, whose
// only entry is `value`.
fn one_class(value: Int) -> Bytes
    u16(2) + u16(18) + u16(0x0004) + u16(0) + u16(24) + u16(28) + u16(1) + u16(1)
        + u16(value)
        + u16(1) + u16(1) + u16(1)
        + u16(2) + u16(0)
        + u16(2) + u16(0)

@test
fn test_the_lookups_of_a_feature_add_and_a_zero_entry_falls_through() [io]
    // Two lookups of one sub-table each: -10 and -5 for glyph 1.
    let two_lookups = u16(1) + u16(0) + u16(10) + u16(30) + u16(46)
        + script_list_default()
        + u16(1) + u32(kern_tag()) + u16(8) + u16(0) + u16(2) + u16(0) + u16(1)
        + u16(2) + u16(6) + u16(14)
        + u16(2) + u16(0) + u16(1) + u16(16)
        + u16(2) + u16(0) + u16(1) + u16(40)
        + one_class(0 - 10) + one_class(0 - 5)
    let p = fontkern.plan(two_lookups, bytes.zeros(0), latn(), 0)!

    test.case("THE CLAIM: each lookup adjusts the pair once, and the adjustments add")
    test.assert(fontkern.pair_value(p, 1, 2) == 0 - 15)
    test.assert(fontkern.pair_count(p) == 2)
    test.assert(fontkern.pair_value(p, 2, 2) == 0)

    test.case("a lookup whose first matrix gives the pair 0 goes on to its next one")
    let two_subtables = u16(1) + u16(0) + u16(10) + u16(30) + u16(44)
        + script_list_default() + feature_list(kern_tag())
        + u16(1) + u16(4)
        + u16(2) + u16(0) + u16(2) + u16(10) + u16(42)
        + one_class(0) + one_class(0 - 7)
    let q = fontkern.plan(two_subtables, bytes.zeros(0), latn(), 0)!
    test.assert(fontkern.pair_value(q, 1, 2) == 0 - 7)

@test
fn test_an_extension_positioning_lookup_is_read_as_pair_adjustment() [io]
    // PairPos format 1 listing (1, 2, -40), behind an extension header.
    let wrapped = table_with(kern_tag(), 9)
        + u16(1) + u16(2) + u32(8)
        + u16(1) + u16(12) + u16(4) + u16(0) + u16(1) + u16(22)
        + u16(1) + u16(1) + u16(1)
        + u16(0) + u16(0)
        + u16(1) + u16(2) + u16(0 - 40)

    test.case("THE CLAIM: the pair behind the extension is kerned")
    let p = fontkern.plan(wrapped, bytes.zeros(0), latn(), 0)!
    test.assert(fontkern.pair_value(p, 1, 2) == 0 - 40)

    test.case("and an extension that is not format 1, or wraps another type, kerns nothing")
    let odd = table_with(kern_tag(), 9) + u16(2) + u16(2) + u32(8)
    test.assert(fontkern.kerns_nothing(fontkern.plan(odd, bytes.zeros(0), latn(), 0)!))
    let other = table_with(kern_tag(), 9) + u16(1) + u16(4) + u32(8)
    test.assert(fontkern.kerns_nothing(fontkern.plan(other, bytes.zeros(0), latn(), 0)!))
